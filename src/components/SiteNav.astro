---
const links = ['About us', 'Products', 'Services', 'Open source', 'Research', 'Let’s talk'];
---

<header class="site-header">
  <nav aria-label="Primary navigation">
    <a class="brand" href="#"><img src="/favicon.svg" width="30" height="30" alt="" />Kochi Labs</a>
    <button class="menu-toggle" type="button" aria-label="Menu" aria-controls="primary-links" aria-expanded="false">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16M4 16h16" /></svg>
    </button>
    <ul id="primary-links">
      {links.map((label) => <li><a href="#">{label}</a></li>)}
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const toggle = header.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';
  const close = () => toggle.setAttribute('aria-expanded', 'false');
  toggle.addEventListener('click', () => toggle.setAttribute('aria-expanded', String(!isOpen())));
  header.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a') && isOpen()) {
      close();
      toggle.focus({ preventScroll: true });
    }
  });
  document.addEventListener('pointerdown', (event) => {
    if (event.target instanceof Node && !header.contains(event.target)) close();
  });
  header.addEventListener('focusout', (event) => {
    if (!(event.relatedTarget instanceof Node) || !header.contains(event.relatedTarget)) close();
  });
  header.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && isOpen()) {
      close();
      toggle.focus();
    }
  });
  matchMedia('(max-width: 820px)').addEventListener('change', close);
</script>

<style>
  .site-header {
    --ink: #203e32;
    --surface: rgb(249 250 239 / 93%);
    --accent: #254737;
    --on-accent: #faf9e9;
    position: fixed;
    z-index: 4;
    top: max(18px, env(safe-area-inset-top));
    left: max(18px, env(safe-area-inset-left));
    right: calc(max(18px, env(safe-area-inset-right)) + 52px);
    color: var(--ink);
    font: 500 14px/1.25 system-ui, sans-serif;
  }
  :global(body[data-time="night"]) .site-header {
    --ink: #f0efda;
    --surface: rgb(21 39 48 / 95%);
    --accent: #dee9d0;
    --on-accent: #203e32;
  }
  nav, ul { display: flex; align-items: center; }
  nav, ul { background: var(--surface); }
  nav {
    justify-content: space-between;
    min-height: 44px;
    border-radius: 24px;
    padding: 0 5px 0 8px;
    box-shadow: 0 2px 12px rgb(19 48 41 / 12%);
  }
  a { color: inherit; text-decoration: none; }
  .brand { display: inline-flex; align-items: center; gap: 9px; font-size: 19px; font-weight: 700; letter-spacing: -.045em; }
  ul { padding: 0; margin: 0; list-style: none; background: transparent; gap: clamp(0px, .5vw, 12px); }
  li a { display: block; padding: 9px clamp(9px, 1vw, 18px); border-radius: 18px; white-space: nowrap; }
  li a:hover, .menu-toggle:hover { background: color-mix(in srgb, var(--ink) 10%, transparent); }
  li:last-child a { background: var(--accent); color: var(--on-accent); padding-inline: 18px; }
  li:last-child a:hover { filter: brightness(1.12); }
  :is(a, button):focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .menu-toggle { display: none; border: 0; border-radius: 50%; background: transparent; color: inherit; cursor: pointer; width: 44px; height: 44px; }
  .menu-toggle svg { width: 21px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }
  @media (max-width: 820px) {
    .menu-toggle { display: grid; place-items: center; }
    ul {
      display: none;
      position: absolute;
      top: calc(100% + 7px);
      right: 0;
      width: min(240px, 100%);
      box-sizing: border-box;
      padding: 8px;
      border-radius: 18px;
      background: var(--surface);
      box-shadow: 0 6px 20px rgb(19 48 41 / 16%);
      max-height: calc(100dvh - 82px);
      overflow: auto;
    }
    .menu-toggle[aria-expanded="true"] + ul { display: block; }
    li a { padding: 13px 14px; }
    li:last-child a { margin-top: 3px; }
  }
  @media (max-width: 480px) {
    .site-header { top: 14px; left: 12px; right: 64px; }
  }
</style>
