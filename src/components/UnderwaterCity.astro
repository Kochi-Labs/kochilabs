<section class="depth-view" aria-labelledby="about-kochi-labs" inert>
  <canvas class="city-canvas" tabindex="0" aria-label="Explore the submerged Kochi waterfront. Drag to look around, use W A S D to swim, or use the landmark selector. Tap buildings and marine life to interact."></canvas>
  <div class="about-copy">
    <h2 id="about-kochi-labs">About us</h2>
    <p>Kochi Labs is a creative technology startup in Kerala. We bring code, illustration, and sound together to build places you can explore on the web.</p>
  </div>
  <div class="explore">
    <span class="feedback" role="status" aria-live="polite"></span>
    <div class="controls">
      <label>
        <span class="sr-only">Explore a city landmark</span>
        <select aria-label="Explore a city landmark"><option value="-1">Waterfront overview</option></select>
      </label>
      <button type="button" class="activate" hidden></button>
    </div>
    <small>Drag to look around · Tap to interact</small>
  </div>
</section>

<script>
  import type { createUnderwaterExplorer } from '../lib/underwater-explorer';
  const section = document.querySelector<HTMLElement>('.depth-view')!;
  let canvas = section.querySelector<HTMLCanvasElement>('canvas')!;
  const select = section.querySelector('select')!;
  const action = section.querySelector<HTMLButtonElement>('.activate')!;
  const feedback = section.querySelector<HTMLElement>('.feedback')!;
  const actions = ['Light the tower', 'Dispatch train', 'Sail the ferry', 'Move cargo'];
  let explorer: ReturnType<typeof createUnderwaterExplorer> | undefined;
  let loading = false, disposed = false, progress = 0;
  let feedbackTimer: ReturnType<typeof setTimeout> | undefined;

  function report(message: string) {
    clearTimeout(feedbackTimer);
    feedback.textContent = message;
    feedbackTimer = setTimeout(() => { feedback.textContent = ''; }, 4200);
  }
  async function loadExplorer() {
    loading = true;
    try {
      const { createUnderwaterExplorer } = await import('../lib/underwater-explorer');
      if (disposed) return;
      explorer = createUnderwaterExplorer(canvas, report);
    } catch {
      if (disposed) return;
      const { createWaterfrontFallback } = await import('../lib/waterfront-fallback');
      if (disposed) return;
      const replacement = canvas.cloneNode(false) as HTMLCanvasElement;
      canvas.replaceWith(replacement); canvas = replacement;
      explorer = createWaterfrontFallback(canvas, report);
    }
    explorer.stops.forEach((label,i) => select.add(new Option(label, String(i))));
    sync();
  }
  function chooseStop() {
    const index = Number(select.value);
    explorer?.visit(index);
    section.dataset.exploring = String(index >= 0);
    action.hidden = index < 0;
    action.textContent = actions[index] ?? '';
    feedback.textContent = '';
  }
  select.addEventListener('change',chooseStop);
  action.addEventListener('click',()=>explorer?.activate());

  function sync() {
    const active = document.body.dataset.diving === 'true';
    section.inert = document.body.dataset.submerged !== 'true';
    if (active && !explorer && !loading) void loadExplorer();
    if (!active && select.value !== '-1') {select.value='-1';chooseStop();}
    explorer?.setState(active,progress);
  }
  window.addEventListener('kochi:dive-depth', event=>{
    progress = (event as CustomEvent<number>).detail;
    sync();
  });
  progress = Number(document.body.style.getPropertyValue('--city-depth')) || 0;
  sync();
  window.addEventListener('pagehide',event=>{
    if (!event.persisted) { disposed=true; clearTimeout(feedbackTimer); explorer?.destroy(); }
  });
</script>

<style>
  .depth-view {
    position: fixed; inset: 0; z-index: 2; isolation: isolate; overflow: hidden;
    pointer-events: none; opacity: var(--city-opacity, 0);
    color: #edf7f7; background: linear-gradient(#175674,#083451 44%,#061d35);
  }
  :global(body[data-submerged="true"]) .depth-view { pointer-events: auto; }
  .city-canvas { width: 100%; height: 100%; display: block; cursor: grab; touch-action: pan-y; }
  .city-canvas:focus-visible { outline: 1px solid #c7f7f1; outline-offset: -4px; }
  .about-copy {
    position: absolute; top: 44%; right: 5.5%; width: clamp(210px, 22vw, 335px); transform: translateY(-50%);
    color: ivory; text-shadow: 0 1px 6px #001521; opacity: var(--about-opacity,0);
    pointer-events: none; transition: opacity .25s;
  }
  .about-copy::before {
    content:''; position:absolute; z-index:-1; inset:-35% -16%;
    background: radial-gradient(ellipse, #001e32c9 5%, #00223a87 45%, transparent 72%); pointer-events:none;
  }
  .depth-view[data-exploring="true"] .about-copy { opacity: 0; }
  h2 { margin: 0 0 .15em; font: 400 clamp(45px, 4.3vw, 70px)/1 Birthstone, cursive; color: #ffedcc; }
  p { margin: 0; font: 450 clamp(14px, 1.07vw, 18px)/1.58 system-ui, sans-serif; text-wrap: pretty; }
  .explore { position:absolute; left: max(5vw,16px); bottom:max(4vh,env(safe-area-inset-bottom)); opacity:var(--about-opacity,0); pointer-events:none; }
  .controls {display:flex; flex-wrap:wrap; gap:6px;align-items:center;}
  .controls label,.activate {pointer-events:auto;}
  select,.activate { box-sizing:border-box; border-radius:7px; padding:8px 10px; font:550 13px/1.25 system-ui,sans-serif;
    color:#f0f4e9; border:1px solid #bfe7ec58; background:#072a3fdc; cursor:pointer; min-height:38px; }
  select:focus-visible,.activate:focus-visible { outline:2px solid #b4eeec;outline-offset:2px; }
  small,.feedback { display:block; font:500 12px/1.4 system-ui,sans-serif; text-shadow:0 1px 5px #001627; }
  small { margin-top:5px; } .feedback:not(:empty) {margin-bottom:8px; width:fit-content; max-width:90vw; background:#062b40dc; padding:5px 8px; border-radius:4px;}
  @media(max-aspect-ratio:1/1){
    .about-copy {top:auto;bottom:15%;right:6%;width:min(73%,310px);transform:none;}
    .about-copy::before { background: radial-gradient(ellipse, #001b30ef 15%, #001b30af 50%, transparent 75%); inset:-28% -20%; }
    .explore {bottom:max(17px,env(safe-area-inset-bottom));}
    h2 {font-size:42px;}
  }
  @media(max-height:460px) and (min-aspect-ratio:1/1){
    .about-copy {top:55%;width:32%;right:3%} h2 {font-size:37px;} p {font-size:13px;}
  }
  @media(prefers-reduced-motion:reduce){.about-copy{transition:none;}}
</style>
