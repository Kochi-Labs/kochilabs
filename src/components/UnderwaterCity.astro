---
const chapters = [
  { title: 'About us', copy: 'Kochi Labs is a software company based in Kerala. We build our own digital products and work with our sister startup to develop custom software for other businesses.' },
  { title: 'Our story', copy: 'Some problems belong to one team. Others turn up everywhere. A conversation about a frustrating task can lead us to software built for one business, or spark an idea for a product many people could use.' },
  { title: 'Our products', copy: 'We design and build a family of digital products. For each one, we start by asking what the person using it needs to get done. That shapes everything from the first screen they see to the cloud services behind it.' },
  { title: 'Our services', copy: 'We build cloud-native applications, integrate AI into existing software, and automate workflows. For example, we can connect a team’s inbox to its order system so details from an incoming document reach the right place without anyone retyping them.' },
];
---
<section data-i18n="aria-label" class="depth-view" aria-label="Kochi Labs story" inert>
  <canvas class="city-canvas" tabindex="0" aria-label="Submerged Kochi waterfront. Scroll along the city. Tap a building, ferry, or fish to interact. Press Enter to activate a landmark."></canvas>
  <span class="scene-feedback" role="status" aria-live="polite"></span>
  <div class="story-shade" aria-hidden="true"></div>
  <div class="story-copy">
    {chapters.map((chapter, index) => (
      <article class="chapter" aria-hidden={index !== 0} data-current={index === 0 ? 'true' : undefined}>
        <h2 data-i18n="text">{chapter.title}</h2>
        <p data-i18n="text">{chapter.copy}</p>
      </article>
    ))}
  </div>
</section>

<script>
  import { onLanguageChange, translate } from '../lib/site-language';

  const section = document.querySelector<HTMLElement>('.depth-view')!;
  let canvas = section.querySelector('canvas')!;
  const feedback = section.querySelector<HTMLElement>('.scene-feedback')!;
  let city: { setState(active: boolean, depth: number, pan: number): void; destroy(): void } | undefined;
  let loading = false;
  let disposed = false;
  let feedbackTimer: ReturnType<typeof setTimeout>;

  const canvasLabel = canvas.getAttribute('aria-label')!;
  let feedbackSource = '';
  function renderFeedback() {
    // Landmark messages include the name of the building that was activated.
    const divider = feedbackSource.indexOf(' · ');
    const whole = translate(feedbackSource);
    feedback.textContent = divider < 0 || whole !== feedbackSource ? whole
      : translate('{value}' + feedbackSource.slice(divider), feedbackSource.slice(0, divider));
  }
  onLanguageChange(() => {
    canvas.setAttribute('aria-label', translate(canvasLabel));
    renderFeedback();
  });

  function report(message: string) {
    clearTimeout(feedbackTimer);
    feedbackSource = message;
    renderFeedback();
    feedbackTimer = setTimeout(() => { feedbackSource = ''; renderFeedback(); }, 3500);
  }

  async function loadCity() {
    loading = true;
    try {
      const { createUnderwaterExplorer } = await import('../lib/underwater-explorer');
      if (disposed) return;
      city = createUnderwaterExplorer(canvas, report);
    } catch {
      if (disposed) return;
      const { createWaterfrontFallback } = await import('../lib/waterfront-fallback');
      if (disposed) return;
      const replacement = canvas.cloneNode(false) as HTMLCanvasElement;
      canvas.replaceWith(replacement);
      canvas = replacement;
      city = createWaterfrontFallback(canvas, report);
    }
    updateStory();
  }
  const chapters = Array.from(section.querySelectorAll<HTMLElement>('.chapter'));
  const motion = matchMedia('(prefers-reduced-motion: reduce)');
  let current = 0;

  function updateStory() {
    const { body } = document;
    section.inert = body.dataset.submerged !== 'true';
    const diving = body.dataset.diving === 'true';
    if (diving && !loading) void loadCity();
    const progress = Number(body.style.getPropertyValue('--story-progress')) || 0;
    const chapter = Math.min(chapters.length - 1, Math.floor(progress * chapters.length));
    if (chapter !== current) {
      chapters[current].removeAttribute('data-current');
      chapters[current].setAttribute('aria-hidden', 'true');
      chapters[chapter].dataset.current = 'true';
      chapters[chapter].setAttribute('aria-hidden', 'false');
      current = chapter;
    }
    const pan = motion.matches ? chapter / (chapters.length - 1) : progress;
    city?.setState(diving, Number(body.style.getPropertyValue('--city-depth')) || 0, pan);
  }
  window.addEventListener('kochi:dive-depth', updateStory);
  motion.addEventListener('change', updateStory);
  updateStory();
  window.addEventListener('pagehide', event => {
    if (event.persisted) return;
    disposed = true;
    clearTimeout(feedbackTimer);
    window.removeEventListener('kochi:dive-depth', updateStory);
    motion.removeEventListener('change', updateStory);
    city?.destroy();
  });
</script>

<style>
  .depth-view {
    position: fixed; inset: 0; z-index: 2; isolation: isolate; overflow: hidden;
    pointer-events: none; opacity: var(--city-opacity, 0); color: #f5f9f4;
    background: linear-gradient(#0c3854, #092c47 45%, #061e31);
  }
  :global(body[data-submerged="true"]) .depth-view { pointer-events: auto; touch-action: pan-y; }
  .city-canvas { display:block; width:100%; height:100%; touch-action:pan-y; }
  .city-canvas:focus-visible { outline:1px solid #c7f7f1; outline-offset:-4px; }
  .scene-feedback { position:absolute; left:5%; top:11%; max-width:85%; pointer-events:none;
    font:500 14px/1.5 system-ui,sans-serif; text-shadow:0 1px 6px #001521; }
  .story-shade {
    position:absolute; inset:0; pointer-events:none;
    background:linear-gradient(90deg,transparent 35%,rgb(1 19 34 / 12%) 48%,rgb(2 20 35 / 69%) 71%,rgb(2 20 35 / 78%));
    opacity:var(--about-opacity,0);
  }
  .story-copy {
    position:absolute; left:53%; right:3%; top:19%; bottom:17%;
    display:grid; align-items:center; pointer-events:none; opacity:var(--about-opacity,0);
  }
  .chapter { grid-area:1 / 1; padding:0 clamp(8px,1.6vw,32px); visibility:hidden; opacity:0; transform:translateX(12px); }
  .chapter[data-current="true"] { visibility:visible; opacity:1; transform:none; transition:opacity .32s ease-out,transform .36s ease-out; }
  h2 { margin:0 0 .21em; font:400 clamp(54px,5.4vw,102px)/1.05 Birthstone,cursive; color:#ffedcc; text-wrap:balance; }
  p { margin:0; max-width:39ch; font:450 clamp(17px,1.48vw,28px)/1.6 system-ui,sans-serif; text-wrap:pretty; text-shadow:0 1px 5px #001521; }
  @media(max-aspect-ratio:1/1){
    .story-shade {background:linear-gradient(0deg,#021322f5 0%,#03192ae8 15%,#021d32bf 37%,transparent 57%);}
    .story-copy { left:7%;right:6%;top:auto;bottom:max(6%,env(safe-area-inset-bottom)); }
    .chapter {padding:0;}
    h2 {font-size:clamp(44px,8.8vw,74px);}
    p {font-size:clamp(16px,2.8vw,22px);max-width:43ch;line-height:1.5;}
  }
  @media(max-height:460px) and (min-aspect-ratio:1/1){
    .story-copy {left:51%;right:3%;top:19%;bottom:5%;}
    h2 {font-size:clamp(32px,5vw,48px);}
    p {font-size:clamp(13px,2vw,17px);line-height:1.4;}
  }
  @media(prefers-reduced-motion:reduce){.chapter[data-current="true"]{transition:none;}}
</style>
