---
import DinoGame from '../components/DinoGame.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#dceef8" />
    <meta name="description" content="Kochi Labs is cooking something." />
    <title>Kochi Labs is cooking something.</title>
    <link rel="icon" href="data:," />
    <link rel="preload" href="/fonts/Birthstone-Regular.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body>
    <main>
      <div class="headline">
        <div class="headline-content">
          <svg class="steam" width="100" height="86" viewBox="0 0 100 86" fill="none" aria-hidden="true">
            <path d="M28 76C9 62 46 53 28 38C14 27 33 18 29 8" />
            <path d="M51 80C32 65 71 53 51 37C34 23 57 14 53 3" />
            <path d="M74 75C56 62 91 51 74 38C61 28 78 21 76 13" />
          </svg>
          <h1>Kochi Labs is cooking something.</h1>
        </div>
      </div>
      <DinoGame />
    </main>
  </body>
</html>

<style is:global>
  @font-face { font-family: "Birthstone"; src: url("/fonts/Birthstone-Regular.ttf") format("truetype"); font-weight: 400; font-style: normal; font-display: swap; }
  :root { font-family: Arial, Helvetica, sans-serif; color: #000; background: #dceef8; color-scheme: light; font-synthesis: none; -webkit-font-smoothing: antialiased; }
  * { box-sizing: border-box; }
  body { margin: 0; }
  button { font: inherit; -webkit-tap-highlight-color: transparent; }
  ::selection { color: #dceef8; background: #000; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
</style>

<style>
  main { width: min(1120px, calc(100% - 48px)); min-height: 100svh; margin-inline: auto; display: flex; flex-direction: column; padding-bottom: clamp(30px, 7vh, 80px); }
  .headline { flex: 1; min-height: 50svh; display: grid; place-items: center; padding-block: 70px; }
  .headline-content { text-align: center; }
  .steam { display: block; width: clamp(65px, 8vw, 100px); height: auto; margin: 0 auto 20px; overflow: visible; }
  .steam path { stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; opacity: .5; transform-origin: center; animation: steam-rise 4.5s ease-in-out infinite; }
  .steam path:nth-child(2) { animation-delay: -.8s; }
  .steam path:nth-child(3) { animation-delay: -1.6s; }
  @keyframes steam-rise { 0%, 100% { transform: translateY(3px); opacity: .35; } 50% { transform: translateY(-4px); opacity: .65; } }
  @media (prefers-reduced-motion: reduce) { .steam path { animation: none; } }
  h1 { margin: 0; font-family: "Birthstone", cursive; font-size: clamp(24px, 6vw, 84px); font-weight: 400; line-height: 1.4; letter-spacing: 0; white-space: nowrap; }
  @media (max-width: 480px) { main { width: calc(100% - 32px); } }
</style>
