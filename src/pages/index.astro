---
import DinoGame from '../components/DinoGame.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#dceef8" />
    <meta name="description" content="God’s own country is cooking something. Kochi Labs." />
    <title>God’s own country is cooking something. — Kochi Labs</title>
    <link rel="icon" href="data:," />
    <link rel="preload" href="/fonts/Birthstone-Regular.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body>
    <div class="landscape" aria-hidden="true">
      <img src="/images/kerala-backwaters.png" alt="" fetchpriority="high" decoding="async" />
    </div>
    <button class="scenery-touch" type="button" aria-label="Explore the Kerala scenery. Click the sky for birds or the water for ripples."></button>
    <div class="scene-effects" aria-hidden="true"></div>
    <main>
      <div class="headline"><h1><button class="headline-trigger" type="button" aria-label="God’s own country is cooking something. Release a flock of birds.">God’s own country is cooking something.</button></h1></div>
      <DinoGame />
    </main>
  </body>
</html>

<script>
  const scenery = document.querySelector<HTMLButtonElement>('.scenery-touch')!;
  const headline = document.querySelector<HTMLButtonElement>('.headline-trigger')!;
  const effects = document.querySelector<HTMLElement>('.scene-effects')!;
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

  function addEffect(element: HTMLElement, frames: Keyframe[], duration: number) {
    while (effects.childElementCount >= 12) effects.firstElementChild?.remove();
    effects.append(element);
    if (reducedMotion.matches) {
      setTimeout(() => element.remove(), 500);
      return;
    }
    const animation = element.animate(frames, { duration, easing: 'ease-out', fill: 'forwards' });
    animation.onfinish = () => element.remove();
  }

  function ripple(x: number, y: number) {
    const ring = document.createElement('span');
    ring.className = 'water-ripple';
    ring.style.left = `${x}px`;
    ring.style.top = `${y}px`;
    addEffect(ring, [
      { transform: 'translate(-50%, -50%) scale(.15)', opacity: .65 },
      { transform: 'translate(-50%, -50%) scale(1)', opacity: 0 },
    ], 1300);
  }

  function releaseBirds(x: number, y: number) {
    for (let i = 0; i < 3; i++) {
      const bird = document.createElement('span');
      bird.className = 'sky-bird';
      bird.style.left = `${x + i * 25}px`;
      bird.style.top = `${y + i * 11}px`;
      bird.innerHTML = '<svg viewBox="0 0 30 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M1 4Q10 0 15 11Q20 0 29 4" /></svg>';
      addEffect(bird, [
        { transform: 'translate(0, 0) scale(1)', opacity: .7 },
        { transform: `translate(${-110 - i * 20}px, ${-65 - i * 15}px) scale(.6)`, opacity: 0 },
      ], 1700 + i * 160);
    }
  }

  scenery.addEventListener('click', (event) => {
    const x = event.detail ? event.clientX : innerWidth / 2;
    const y = event.detail ? event.clientY : innerHeight * .72;
    if (y > innerHeight * .56) ripple(x, y);
    else releaseBirds(x, y);
  });
  headline.addEventListener('click', () => {
    const bounds = headline.getBoundingClientRect();
    releaseBirds(bounds.left + bounds.width * .65, bounds.top - 12);
  });
  document.addEventListener('pointermove', (event) => {
    if (reducedMotion.matches || event.pointerType !== 'mouse') return;
    document.documentElement.style.setProperty('--scene-x', `${(event.clientX / innerWidth - .5) * -8}px`);
    document.documentElement.style.setProperty('--scene-y', `${(event.clientY / innerHeight - .5) * -5}px`);
  }, { passive: true });
  document.addEventListener('pointerleave', () => {
    document.documentElement.style.setProperty('--scene-x', '0px');
    document.documentElement.style.setProperty('--scene-y', '0px');
  });
</script>

<style is:global>
  @font-face { font-family: "Birthstone"; src: url("/fonts/Birthstone-Regular.ttf") format("truetype"); font-weight: 400; font-style: normal; font-display: swap; }
  :root { font-family: Arial, Helvetica, sans-serif; color: #000; background: #dceef8; color-scheme: light; font-synthesis: none; -webkit-font-smoothing: antialiased; }
  * { box-sizing: border-box; }
  body { margin: 0; isolation: isolate; }
  button { font: inherit; -webkit-tap-highlight-color: transparent; }
  ::selection { color: #dceef8; background: #000; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
</style>

<style>
  .landscape { position: fixed; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; }
  .landscape img { width: 100%; height: 100%; object-fit: cover; object-position: center center; transform: scale(1.015) translate(var(--scene-x, 0px), var(--scene-y, 0px)); transition: transform .4s ease-out; }
  .landscape::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(239,248,251,.12) 0%, rgba(239,248,251,.08) 46%, rgba(235,245,241,.30) 66%, rgba(235,245,241,.90) 86%, rgba(235,245,241,.96) 100%); }
  .scenery-touch { position: fixed; inset: 0; z-index: 0; width: 100%; height: 100%; border: 0; padding: 0; background: transparent; cursor: crosshair; }
  .scenery-touch:focus-visible { outline: 1px solid rgba(20,60,50,.4); outline-offset: -8px; }
  .scene-effects { position: fixed; inset: 0; z-index: 2; pointer-events: none; overflow: hidden; }
  .scene-effects :global(.water-ripple) { position: absolute; width: 150px; height: 44px; border: 1px solid rgba(28,76,70,.6); border-radius: 50%; box-shadow: 0 0 0 9px rgba(255,255,255,.25); transform: translate(-50%, -50%); }
  .scene-effects :global(.sky-bird) { position: absolute; width: 25px; height: 14px; color: #203c34; }
  main { position: relative; z-index: 1; pointer-events: none; width: min(1120px, calc(100% - 48px)); min-height: 100svh; margin-inline: auto; display: flex; flex-direction: column; padding-bottom: clamp(30px, 7vh, 80px); }
  .headline-trigger, :global(.runner) { pointer-events: auto; }
  .headline-trigger { display: inline-block; padding: 0; border: 0; background: transparent; color: inherit; font: inherit; cursor: pointer; text-shadow: inherit; transition: color .2s, transform .2s; }
  .headline-trigger:hover { color: #254f43; transform: translateY(-1px); }
  .headline-trigger:active { transform: translateY(1px); }
  .headline-trigger:focus-visible { outline: none; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 8px; }
  .headline { flex: 1; min-height: 50svh; display: grid; place-items: center; padding-block: 70px; text-align: center; }
  h1 { margin: 0; font-family: "Birthstone", cursive; font-size: clamp(22px, 5.6vw, 78px); font-weight: 400; line-height: 1.4; letter-spacing: 0; white-space: nowrap; text-shadow: 0 1px 14px rgba(255,255,255,.6); }
  @media (max-width: 480px) { main { width: calc(100% - 32px); } .landscape img { object-position: 52% center; } }
  @media (prefers-reduced-motion: reduce) { .landscape img { transform: none; transition: none; } .headline-trigger { transition: none; transform: none; } }
</style>
