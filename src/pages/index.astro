---
import DinoGame from '../components/DinoGame.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content="Kochi Raps is cooking something." />
    <title>Kochi Raps is cooking something.</title>
    <link rel="icon" href="data:," />
  </head>
  <body>
    <main>
      <div class="headline"><h1>Kochi Raps is cooking something.</h1></div>
      <DinoGame />
    </main>
  </body>
</html>

<style is:global>
  :root { font-family: Arial, Helvetica, sans-serif; color: #ffed00; background: #000; color-scheme: dark; font-synthesis: none; -webkit-font-smoothing: antialiased; }
  * { box-sizing: border-box; }
  body { margin: 0; }
  button { font: inherit; -webkit-tap-highlight-color: transparent; }
  ::selection { color: #000; background: #ffed00; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
</style>

<style>
  main { width: min(1120px, calc(100% - 48px)); min-height: 100svh; margin-inline: auto; display: flex; flex-direction: column; padding-bottom: clamp(30px, 7vh, 80px); }
  .headline { flex: 1; min-height: 50svh; display: grid; place-items: center; padding-block: 70px; }
  h1 { margin: 0; font-size: clamp(14px, 3.5vw, 48px); font-weight: 500; line-height: 1.3; letter-spacing: -.045em; white-space: nowrap; }
  @media (max-width: 480px) { main { width: calc(100% - 32px); } }
</style>
