---
import DinoGame from '../components/DinoGame.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#dceef8" />
    <meta name="description" content="God’s own country is cooking something. Kochi Labs." />
    <title>God’s own country is cooking something. — Kochi Labs</title>
    <link rel="icon" href="data:," />
    <link rel="preload" href="/fonts/Birthstone-Regular.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body>
    <header class="brand-lockup" aria-label="Kochi Labs" hidden>
      <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
        <g fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <path d="M16 4v24M4 16h24M7.5 7.5l17 17M7.5 24.5l17-17" />
        </g>
      </svg>
      <span class="brand-name">Kochi <span>Labs</span></span>
    </header>
    <div class="landscape" aria-hidden="true">
      <img src="/images/kerala-backwaters-clean.png" alt="" fetchpriority="high" decoding="async" />
    </div>
    <canvas class="kerala-scene" tabindex="0" role="img" aria-label="Interactive Kerala backwaters. Click the water to make waves and float a lotus. Drag the houseboat, brush or shake the trees, and click a house to open its windows and light it inside. Click the metro to start a rear-carriage fire and rain sequence, or scroll to explore. Press Enter to ripple the water."></canvas>
    <div class="scene-wash" aria-hidden="true"></div>
    <div class="night-wash" aria-hidden="true"></div>
    <div class="storm-wash" aria-hidden="true"></div>
    <svg class="stars" viewBox="0 0 1000 500" preserveAspectRatio="none" aria-hidden="true">
      {[...Array(44)].map((_, i) => <circle cx={28 + ((i * 137) % 944)} cy={18 + ((i * 79) % 420)} r={i % 5 === 0 ? 1.7 : .85} opacity={.35 + (i % 4) * .18} />)}
    </svg>
    <button class="celestial" type="button" aria-label="Sun. Double-click to change to night. Enter or Space also works." aria-pressed="false" title="Double-click for night">
      <svg class="sun" viewBox="0 0 100 100" aria-hidden="true">
        <defs>
          <radialGradient id="sun-atmosphere"><stop stop-color="#fff6c8" stop-opacity=".72" /><stop offset=".55" stop-color="#ffe6a1" stop-opacity=".25" /><stop offset="1" stop-color="#ffcf7c" stop-opacity="0" /></radialGradient>
          <radialGradient id="sun-surface" cx="42%" cy="38%" r="68%"><stop stop-color="#fffff0" /><stop offset=".55" stop-color="#fff8d1" /><stop offset=".85" stop-color="#ffe5a0" /><stop offset="1" stop-color="#f6cb7e" /></radialGradient>
        </defs>
        <circle cx="50" cy="50" r="49" fill="url(#sun-atmosphere)" />
        <circle cx="50" cy="50" r="25" fill="url(#sun-surface)" />
      </svg>
      <svg class="moon" viewBox="0 0 100 100" aria-hidden="true">
        <defs><mask id="moon-cutout"><rect width="100" height="100" fill="white" /><circle cx="66" cy="34" r="28" fill="black" /></mask></defs>
        <g mask="url(#moon-cutout)">
          <circle cx="50" cy="50" r="31" fill="#f4eac5" />
          <circle cx="37" cy="58" r="5" fill="#c9d3ce" opacity=".6" />
          <circle cx="49" cy="71" r="3" fill="#c9d3ce" opacity=".45" />
          <circle cx="28" cy="46" r="2.5" fill="#c9d3ce" opacity=".4" />
        </g>
      </svg>
    </button>
    <span class="sr-only" role="status" id="time-status"></span>
    <span class="sr-only" role="status" id="village-status"></span>
    <nav class="village-controls" aria-label="Village interactions"><button class="scene-shortcut bottle-shortcut" type="button" hidden>Read the message in the floating bottle</button></nav>
    <dialog class="bottle-note" aria-label="An old palm-leaf message" aria-describedby="bottle-message">
      <form method="dialog"><button class="note-close" aria-label="Close note" autofocus>×</button></form>
      <canvas class="leaf-scroll-canvas" aria-hidden="true"></canvas>
      <p id="bottle-message"></p>
      <span class="leaf-binding leaf-binding-left" aria-hidden="true"></span>
      <span class="leaf-binding leaf-binding-right" aria-hidden="true"></span>
    </dialog>
    <main>
      <div class="headline">
        <h1><button class="headline-trigger" type="button" lang="en" aria-label="God’s own country is cooking something. Click to change language.">God’s own country is cooking something.</button></h1>

      </div>
      <DinoGame />
    </main>
  </body>
</html>

<script>
  import { createKeralaScene } from '../lib/kerala-scene';
  import { installHeadlineLanguages } from '../lib/headline-languages';
  import { installBottleNote } from '../lib/bottle-note';

  // A shareable placement concept, enabled only by the demo URL.
  document.querySelector<HTMLElement>('.brand-lockup')!.hidden = new URLSearchParams(location.search).get('brand') !== 'demo';

  const canvas = document.querySelector<HTMLCanvasElement>('.kerala-scene')!;
  const headline = document.querySelector<HTMLButtonElement>('.headline-trigger')!;
  const noteDialog = document.querySelector<HTMLDialogElement>('.bottle-note')!;
  const bottleButton = document.querySelector<HTMLButtonElement>('.bottle-shortcut')!;
  const bottleNote = installBottleNote(noteDialog);
  const houseButtons: HTMLButtonElement[] = [];
  const scene = createKeralaScene(canvas, {
    backgroundUrl: '/images/kerala-backwaters-clean.png',
    moonElement: document.querySelector<HTMLButtonElement>('.celestial')!,
    onBottleAvailable(available) { bottleButton.hidden = !available; },
    onBottleFound() { bottleNote.open(); },
    onHouseChange(index, open, automatic) {
      const button = houseButtons[index];
      if (button) {
        button.setAttribute('aria-pressed', String(open));
        button.textContent = `${open ? 'Close' : 'Open'} windows: ${scene.houseLabels[index]}`;
      }
      if (!automatic) document.querySelector('#village-status')!.textContent = `${scene.houseLabels[index]}: ${open ? 'windows open, lights on' : 'windows closed, lights off'}.`;
    },
    onStormChange(intensity) { document.body.style.setProperty('--storm', String(intensity)); },
    onSequencePhase(phase) {
      const status = document.querySelector('#village-status')!;
      if (phase === 'rain') status.textContent = 'Rain sweeps over the metro, cooling the damaged rear carriage and extinguishing the fire.';
      if (phase === 'cooled') status.textContent = 'The fire is out. Steam lifts from the scorched metro as the rain eases.';
    },
    onPassengerFound() {
      document.querySelector('#village-status')!.textContent = 'The last metro carriage catches fire. Rain will arrive to extinguish it.';
    },
    onCoconutSplash() {
      document.querySelector('#village-status')!.textContent = 'A coconut splashes into the backwaters and floats.';
    },
    onReady(supported) {
      document.body.dataset.scene = supported ? 'ready' : 'fallback';
    },
  });
  const villageControls = document.querySelector<HTMLElement>('.village-controls')!;
  bottleButton.addEventListener('click', () => scene.openBottle());
  noteDialog.addEventListener('keydown', (event) => event.stopPropagation());
  noteDialog.addEventListener('close', () => canvas.focus({ preventScroll: true }));
  noteDialog.addEventListener('click', (event) => {
    if (event.target !== noteDialog) return;
    const bounds = noteDialog.getBoundingClientRect();
    if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) bottleNote.close();
  });
  scene.houseLabels.forEach((label, index) => {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'scene-shortcut';
    button.textContent = `Open windows: ${label}`;
    button.setAttribute('aria-pressed', 'false');
    button.addEventListener('click', () => scene.toggleHouse(index));
    houseButtons.push(button);
    villageControls.append(button);
  });
  if (scene.houseLabels.length) {
    const shake = document.createElement('button');
    shake.type = 'button';
    shake.className = 'scene-shortcut';
    shake.textContent = 'Shake a palm and drop a coconut';
    shake.addEventListener('click', () => scene.shakePalm());
    villageControls.append(shake);
  }
  const celestial = document.querySelector<HTMLButtonElement>('.celestial')!;
  let isNight = false;
  let lastTap = 0;
  let lastTouch = -1000;
  const toggleNight = () => {
    isNight = !isNight;
    document.body.dataset.time = isNight ? 'night' : 'day';
    scene.setNight(isNight);
    celestial.setAttribute('aria-pressed', String(isNight));
    celestial.setAttribute('aria-label', `${isNight ? 'Moon' : 'Sun'}. Double-click to change to ${isNight ? 'day' : 'night'}. Enter or Space also works.`);
    celestial.title = `Double-click for ${isNight ? 'day' : 'night'}`;
    document.querySelector('#time-status')!.textContent = isNight ? 'Night falls over the backwaters. All village houses light up.' : 'Daylight returns to the backwaters.';
    document.querySelector('meta[name="theme-color"]')!.setAttribute('content', isNight ? '#101e38' : '#dceef8');
  };
  celestial.addEventListener('dblclick', () => {
    if (performance.now() - lastTouch > 600) toggleNight();
  });
  // Native keyboard and assistive-technology activation has no pointer click count.
  celestial.addEventListener('click', (event) => { if (event.detail === 0) toggleNight(); });
  celestial.addEventListener('pointerup', (event) => {
    if (event.pointerType !== 'touch' && event.pointerType !== 'pen') return;
    const now = performance.now();
    lastTouch = now;
    if (lastTap > 0 && now - lastTap < 400) { toggleNight(); lastTap = 0; }
    else lastTap = now;
  });
  celestial.addEventListener('pointercancel', () => { lastTap = 0; });

  const scrollScene = () => {
    const travel = document.documentElement.scrollHeight - innerHeight;
    scene.setScroll(travel > 0 ? Math.min(1, Math.max(0, scrollY / travel)) : 0);
  };
  const disposeLanguages = installHeadlineLanguages(headline, bottleNote.setLanguage);
  const keyboardSplash = (event: KeyboardEvent) => {
    if (event.key !== 'Enter') return;
    event.preventDefault();
    scene.splashAt(innerWidth * .52, innerHeight * .73);
  };
  canvas.addEventListener('keydown', keyboardSplash);
  addEventListener('scroll', scrollScene, { passive: true });
  addEventListener('resize', scrollScene, { passive: true });
  scrollScene();
  addEventListener('pagehide', (event) => { if (!event.persisted) { disposeLanguages(); bottleNote.destroy(); scene.destroy(); } });
</script>

<style is:global>
  @font-face { font-family: "Birthstone"; src: url("/fonts/Birthstone-Regular.ttf") format("truetype"); font-weight: 400; font-style: normal; font-display: swap; }
  @font-face { font-family: "Noto Serif Devanagari"; src: url("/fonts/NotoSerifDevanagari.ttf") format("truetype"); font-weight: 100 900; font-style: normal; font-display: swap; }
  :root { font-family: Arial, Helvetica, sans-serif; color: #000; background: #dceef8; color-scheme: light; font-synthesis: none; -webkit-font-smoothing: antialiased; }
  * { box-sizing: border-box; }
  body { margin: 0; isolation: isolate; min-height: 175svh; overscroll-behavior-y: none; }
  button { font: inherit; -webkit-tap-highlight-color: transparent; }
  ::selection { color: #dceef8; background: #000; }
  .scene-shortcut:not(:focus-visible), .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .scene-shortcut:focus-visible { position: fixed; z-index: 5; left: 50%; bottom: 16px; transform: translateX(-50%); max-width: calc(100% - 24px); padding: 12px 18px; border: 1px solid #e6d7ae; border-radius: 6px; background: #183c3b; color: #fff3d5; outline: 2px solid #ffdb88; outline-offset: 3px; }
</style>

<style>
  .brand-lockup { position: fixed; z-index: 2; top: max(env(safe-area-inset-top), clamp(28px, 4.5svh, 44px)); left: 50%; transform: translateX(-50%); display: flex; align-items: center; gap: 10px; color: #204b43; pointer-events: none; user-select: none; text-shadow: 0 1px 12px #edf7f56b; transition: color .9s ease; }
  .brand-lockup[hidden] { display: none; }
  .brand-mark { width: 25px; height: 25px; flex: none; }
  .brand-name { font: 600 19px/1.2 Arial, Helvetica, sans-serif; letter-spacing: -.5px; white-space: nowrap; }
  .brand-name span { font-weight: 400; }
  :global(body[data-time="night"]) .brand-lockup { color: #f2e8c9; text-shadow: 0 1px 14px #071b3b80; }
  @media (max-width: 480px) { .brand-lockup { gap: 8px; top: max(env(safe-area-inset-top), 28px); } .brand-mark { width: 22px; height: 22px; } .brand-name { font-size: 17px; } }
  @media (prefers-reduced-motion: reduce) { .brand-lockup { transition: none; } }
  .leaf-scroll-canvas { display: none; width: 100%; height: clamp(220px, 42vw, 300px); pointer-events: none; }
  .bottle-note[data-scroll="ready"] { width: min(660px, calc(100vw - 24px)); padding: 0; border: 0; background: none; box-shadow: none; transform: none; }
  .bottle-note[data-scroll="ready"]::before, .bottle-note[data-scroll="ready"] .leaf-binding { display: none; }
  .bottle-note[data-scroll="ready"] .leaf-scroll-canvas { display: block; }
  .bottle-note[data-scroll="ready"] p { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .bottle-note[data-scroll="ready"] .note-close { z-index: 3; top: 0; right: 2px; background: #deca96; box-shadow: 0 2px 9px #192b3533; border-radius: 50%; }
  .bottle-note { position: fixed; inset: 0; width: min(600px, calc(100vw - 36px)); margin: auto; padding: 60px 60px 54px; border: 1px solid #8e763d; border-radius: 34px 7px 28px 11px / 13px 22px 14px 23px; color: #48351c; background: radial-gradient(ellipse at 4% 70%, #715b294d, transparent 35%), radial-gradient(ellipse at 96% 15%, #70562d55, transparent 30%), repeating-linear-gradient(0deg, #5d562b16 0 1px, transparent 1px 4px), linear-gradient(180deg, #cbb77a, #dccb8d 35%, #c7ae69 80%, #a58a48); box-shadow: 0 16px 65px #071d2266, inset 0 0 19px #72572666, inset 0 2px 2px #f8e8b599; transform: rotate(-1deg); overflow: visible; }
  .bottle-note::before { content: ''; position: absolute; inset: 9px 12px; border-block: 1px solid #79623744; border-radius: inherit; pointer-events: none; }
  .bottle-note::backdrop { background: #0c27264d; backdrop-filter: blur(3px); }
  .bottle-note p { margin: 0; text-align: center; font: 400 clamp(34px, 5vw, 43px)/1.25 'Birthstone', cursive; text-shadow: 0 1px #e6d29788; text-wrap: pretty; }
  .bottle-note p:lang(hi) { font: 400 clamp(22px, 4vw, 30px)/1.7 'Noto Serif Devanagari', serif; }
  .leaf-binding { position: absolute; top: 50%; width: 9px; height: 9px; border: 2px solid #80612e; border-radius: 50%; background: #382d1d; box-shadow: 0 1px 1px #edda9c; }
  .leaf-binding-left { left: 22px; }
  .leaf-binding-right { right: 22px; }
  .leaf-binding::after { content: ''; position: absolute; width: 2px; height: 36px; top: 1px; left: 2px; border-right: 2px solid #ae874a; border-radius: 50%; transform: rotate(13deg); }
  .note-close { position: absolute; top: 8px; right: 9px; width: 36px; height: 36px; border: 0; background: transparent; font: 25px/1 Arial, sans-serif; color: #544224; cursor: pointer; }
  .note-close:focus-visible { outline: 1px solid #665129; border-radius: 50%; outline-offset: -4px; }
  @media (max-width: 480px) { .bottle-note { padding: 54px 39px 46px; } .leaf-binding-left { left: 14px; } .leaf-binding-right { right: 14px; } }
  .landscape { position: fixed; inset: 0; z-index: -2; pointer-events: none; overflow: hidden; }
  .landscape img { transition: filter .9s ease; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .kerala-scene { position: fixed; inset: 0; z-index: -1; display: block; width: 100%; height: 100%; cursor: crosshair; outline: none; touch-action: pan-y; }
  .kerala-scene:focus-visible { box-shadow: inset 0 0 0 2px rgba(33,77,66,.35); }
  :global(body[data-scene="fallback"]) .kerala-scene { visibility: hidden; }
  :global(body[data-scene="fallback"]) .village-controls { display: none; }
  .scene-wash { position: fixed; inset: 0; z-index: 0; pointer-events: none; background: linear-gradient(180deg, rgba(239,248,251,.10) 0%, rgba(239,248,251,.04) 48%, rgba(235,245,241,.02) 72%, rgba(235,245,241,.80) 89%, rgba(235,245,241,.94) 100%); }
  .scene-wash { transition: opacity .9s ease; }
  .storm-wash { position: fixed; inset: 0; z-index: 0; pointer-events: none; background: linear-gradient(180deg, rgba(23,36,48,.56), rgba(52,70,80,.2)); opacity: var(--storm, 0); }
  .night-wash { position: fixed; inset: 0; z-index: 0; pointer-events: none; opacity: 0; background: linear-gradient(180deg, transparent 50%, rgba(8,20,39,.1) 72%, rgba(8,20,39,.65) 100%); transition: opacity .9s ease; }
  .stars { position: fixed; inset: 0 0 auto; width: 100%; height: 51svh; z-index: 0; pointer-events: none; fill: #fff1cc; opacity: 0; transition: opacity 1.1s ease; }
  .celestial { position: fixed; top: 10svh; right: 18%; z-index: 2; width: clamp(76px, 8vw, 112px); aspect-ratio: 1; border: 0; padding: 0; border-radius: 50%; background: transparent; cursor: pointer; touch-action: manipulation; -webkit-user-select: none; user-select: none; }
  .celestial svg { position: absolute; inset: 0; width: 100%; height: 100%; transition: opacity .7s ease, transform .7s ease; pointer-events: none; }
  .celestial .sun { filter: drop-shadow(0 0 18px #ffe6a15c); }
  .celestial .moon { opacity: 0; transform: rotate(-35deg) scale(.65); filter: drop-shadow(0 0 14px #ebf2cf66); }
  .celestial:hover .sun { filter: drop-shadow(0 0 22px #ffe6a180); }
  .celestial:focus-visible { outline: 1px dashed currentColor; outline-offset: 3px; }
  :global(body[data-time="night"]) { color: #f6efd9; background: #101e38; }
  :global(body[data-time="night"]) .landscape img { filter: brightness(.25) sepia(.6) hue-rotate(165deg) saturate(1.3); }
  :global(body[data-time="night"]) .scene-wash { opacity: 0; }
  :global(body[data-time="night"]) .night-wash, :global(body[data-time="night"]) .stars { opacity: 1; }
  :global(body[data-time="night"]) .celestial .sun { opacity: 0; transform: rotate(35deg) scale(.65); }
  :global(body[data-time="night"]) .celestial .moon { opacity: 1; transform: rotate(0) scale(1); }
  :global(body[data-time="night"]) h1 { text-shadow: 0 1px 18px rgba(6,18,40,.7); }
  :global(body[data-time="night"]) .headline-trigger:hover { color: #ffe4a6; }
  :global(.runner) { transition: filter .9s ease; }
  :global(body[data-time="night"] .runner) { filter: invert(1); }
  h1 { transition: color .9s ease, text-shadow .9s ease; }
  main { position: fixed; inset: 0; z-index: 1; pointer-events: none; width: min(1120px, calc(100% - 48px)); height: 100svh; margin-inline: auto; display: flex; flex-direction: column; padding-bottom: clamp(30px, 7vh, 80px); }
  .headline-trigger, :global(.runner) { pointer-events: auto; }
  .headline-trigger { display: inline-block; max-width: 100%; text-wrap: balance; padding: 0; border: 0; background: transparent; color: inherit; font: inherit; cursor: pointer; text-shadow: inherit; transition: color .2s, transform .2s; }
  .headline-trigger:hover { color: #254f43; transform: translateY(-1px); }
  .headline-trigger:active { transform: translateY(1px); }
  .headline-trigger:focus-visible { outline: none; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 8px; }
  .headline { position: relative; flex: 1; min-height: 50svh; display: grid; place-items: center; padding-block: 70px; text-align: center; }
  h1 { margin: 0; font-family: "Birthstone", cursive; font-size: clamp(30px, 5.6vw, 78px); font-weight: 400; line-height: 1.4; letter-spacing: 0; max-width: 100%; white-space: normal; text-shadow: 0 1px 14px rgba(255,255,255,.6); }
  .headline-trigger:lang(hi) { font-family: "Noto Serif Devanagari", serif; font-size: clamp(23px, 3.7vw, 52px); line-height: 1.55; }
  @media (max-width: 480px) { main { width: calc(100% - 32px); padding-bottom: 24px; } }
  @media (max-height: 900px) and (min-aspect-ratio: 1/1) {
    main { padding-bottom: 14px; }
    main :global(.runner-heading) { height: 32px; }
    main :global(.runner-canvas) { height: 95px; }
    main :global(.runner-restart) { top: 20px; }
    .headline { padding-block: 24px; }
  }
  @media (prefers-reduced-motion: reduce) { .landscape img, .scene-wash, .night-wash, .stars, .celestial svg, h1, :global(.runner) { transition: none; } .headline-trigger { transition: none; transform: none; } }
</style>
