---
import DinoGame from '../components/DinoGame.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#dceef8" />
    <meta name="description" content="God’s own country is cooking something. Kochi Labs." />
    <title>God’s own country is cooking something. — Kochi Labs</title>
    <link rel="icon" href="data:," />
    <link rel="preload" href="/fonts/Birthstone-Regular.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body>
    <div class="landscape" aria-hidden="true">
      <img src="/images/kerala-backwaters-clean.png" alt="" fetchpriority="high" decoding="async" />
    </div>
    <canvas class="kerala-scene" tabindex="0" role="img" aria-label="Interactive Kerala backwaters. Click the water to make waves and float a lotus. Drag the houseboat, tap the metro, or scroll to explore. Press Enter to ripple the water."></canvas>
    <div class="scene-wash" aria-hidden="true"></div>
    <div class="night-wash" aria-hidden="true"></div>
    <svg class="stars" viewBox="0 0 1000 500" preserveAspectRatio="none" aria-hidden="true">
      {[...Array(44)].map((_, i) => <circle cx={28 + ((i * 137) % 944)} cy={18 + ((i * 79) % 420)} r={i % 5 === 0 ? 1.7 : .85} opacity={.35 + (i % 4) * .18} />)}
    </svg>
    <button class="celestial" type="button" aria-label="Sun. Double-click to change to night. Enter or Space also works." aria-pressed="false" title="Double-click for night">
      <svg class="sun" viewBox="0 0 100 100" aria-hidden="true">
        <defs>
          <radialGradient id="sun-atmosphere"><stop stop-color="#fff6c8" stop-opacity=".72" /><stop offset=".55" stop-color="#ffe6a1" stop-opacity=".25" /><stop offset="1" stop-color="#ffcf7c" stop-opacity="0" /></radialGradient>
          <radialGradient id="sun-surface" cx="42%" cy="38%" r="68%"><stop stop-color="#fffff0" /><stop offset=".55" stop-color="#fff8d1" /><stop offset=".85" stop-color="#ffe5a0" /><stop offset="1" stop-color="#f6cb7e" /></radialGradient>
        </defs>
        <circle cx="50" cy="50" r="49" fill="url(#sun-atmosphere)" />
        <circle cx="50" cy="50" r="25" fill="url(#sun-surface)" />
      </svg>
      <svg class="moon" viewBox="0 0 100 100" aria-hidden="true">
        <defs><mask id="moon-cutout"><rect width="100" height="100" fill="white" /><circle cx="66" cy="34" r="28" fill="black" /></mask></defs>
        <g mask="url(#moon-cutout)">
          <circle cx="50" cy="50" r="31" fill="#f4eac5" />
          <circle cx="37" cy="58" r="5" fill="#c9d3ce" opacity=".6" />
          <circle cx="49" cy="71" r="3" fill="#c9d3ce" opacity=".45" />
          <circle cx="28" cy="46" r="2.5" fill="#c9d3ce" opacity=".4" />
        </g>
      </svg>
    </button>
    <span class="sr-only" role="status" id="time-status"></span>
    <main>
      <div class="headline"><h1><button class="headline-trigger" type="button" aria-label="God’s own country is cooking something. Release birds and rock the houseboat.">God’s own country is cooking something.</button></h1></div>
      <DinoGame />
    </main>
  </body>
</html>

<script>
  import { createKeralaScene } from '../lib/kerala-scene';

  const canvas = document.querySelector<HTMLCanvasElement>('.kerala-scene')!;
  const headline = document.querySelector<HTMLButtonElement>('.headline-trigger')!;
  const scene = createKeralaScene(canvas, {
    backgroundUrl: '/images/kerala-backwaters-clean.png',
    moonElement: document.querySelector<HTMLButtonElement>('.celestial')!,
    onReady(supported) {
      document.body.dataset.scene = supported ? 'ready' : 'fallback';
    },
  });
  const celestial = document.querySelector<HTMLButtonElement>('.celestial')!;
  let isNight = false;
  let lastTap = 0;
  let lastTouch = -1000;
  const toggleNight = () => {
    isNight = !isNight;
    document.body.dataset.time = isNight ? 'night' : 'day';
    scene.setNight(isNight);
    celestial.setAttribute('aria-pressed', String(isNight));
    celestial.setAttribute('aria-label', `${isNight ? 'Moon' : 'Sun'}. Double-click to change to ${isNight ? 'day' : 'night'}. Enter or Space also works.`);
    celestial.title = `Double-click for ${isNight ? 'day' : 'night'}`;
    document.querySelector('#time-status')!.textContent = isNight ? 'Night falls over the backwaters.' : 'Daylight returns to the backwaters.';
    document.querySelector('meta[name="theme-color"]')!.setAttribute('content', isNight ? '#101e38' : '#dceef8');
  };
  celestial.addEventListener('dblclick', () => {
    if (performance.now() - lastTouch > 600) toggleNight();
  });
  // Native keyboard and assistive-technology activation has no pointer click count.
  celestial.addEventListener('click', (event) => { if (event.detail === 0) toggleNight(); });
  celestial.addEventListener('pointerup', (event) => {
    if (event.pointerType !== 'touch' && event.pointerType !== 'pen') return;
    const now = performance.now();
    lastTouch = now;
    if (lastTap > 0 && now - lastTap < 400) { toggleNight(); lastTap = 0; }
    else lastTap = now;
  });
  celestial.addEventListener('pointercancel', () => { lastTap = 0; });

  const scrollScene = () => {
    const travel = document.documentElement.scrollHeight - innerHeight;
    scene.setScroll(travel > 0 ? Math.min(1, Math.max(0, scrollY / travel)) : 0);
  };
  const stirScene = () => { scene.nudgeBoat(); scene.releaseBirds(); };
  const keyboardSplash = (event: KeyboardEvent) => {
    if (event.key !== 'Enter') return;
    event.preventDefault();
    scene.splashAt(innerWidth * .52, innerHeight * .73);
  };
  headline.addEventListener('click', stirScene);
  canvas.addEventListener('keydown', keyboardSplash);
  addEventListener('scroll', scrollScene, { passive: true });
  addEventListener('resize', scrollScene, { passive: true });
  scrollScene();
  addEventListener('pagehide', (event) => { if (!event.persisted) scene.destroy(); });
</script>

<style is:global>
  @font-face { font-family: "Birthstone"; src: url("/fonts/Birthstone-Regular.ttf") format("truetype"); font-weight: 400; font-style: normal; font-display: swap; }
  :root { font-family: Arial, Helvetica, sans-serif; color: #000; background: #dceef8; color-scheme: light; font-synthesis: none; -webkit-font-smoothing: antialiased; }
  * { box-sizing: border-box; }
  body { margin: 0; isolation: isolate; min-height: 175svh; overscroll-behavior-y: none; }
  button { font: inherit; -webkit-tap-highlight-color: transparent; }
  ::selection { color: #dceef8; background: #000; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
</style>

<style>
  .landscape { position: fixed; inset: 0; z-index: -2; pointer-events: none; overflow: hidden; }
  .landscape img { transition: filter .9s ease; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .kerala-scene { position: fixed; inset: 0; z-index: -1; display: block; width: 100%; height: 100%; cursor: crosshair; outline: none; touch-action: pan-y; }
  .kerala-scene:focus-visible { box-shadow: inset 0 0 0 2px rgba(33,77,66,.35); }
  :global(body[data-scene="fallback"]) .kerala-scene { visibility: hidden; }
  .scene-wash { position: fixed; inset: 0; z-index: 0; pointer-events: none; background: linear-gradient(180deg, rgba(239,248,251,.10) 0%, rgba(239,248,251,.04) 48%, rgba(235,245,241,.02) 72%, rgba(235,245,241,.80) 89%, rgba(235,245,241,.94) 100%); }
  .scene-wash { transition: opacity .9s ease; }
  .night-wash { position: fixed; inset: 0; z-index: 0; pointer-events: none; opacity: 0; background: linear-gradient(180deg, transparent 50%, rgba(8,20,39,.1) 72%, rgba(8,20,39,.65) 100%); transition: opacity .9s ease; }
  .stars { position: fixed; inset: 0 0 auto; width: 100%; height: 51svh; z-index: 0; pointer-events: none; fill: #fff1cc; opacity: 0; transition: opacity 1.1s ease; }
  .celestial { position: fixed; top: 10svh; right: 18%; z-index: 2; width: clamp(76px, 8vw, 112px); aspect-ratio: 1; border: 0; padding: 0; border-radius: 50%; background: transparent; cursor: pointer; touch-action: manipulation; -webkit-user-select: none; user-select: none; }
  .celestial svg { position: absolute; inset: 0; width: 100%; height: 100%; transition: opacity .7s ease, transform .7s ease; pointer-events: none; }
  .celestial .sun { filter: drop-shadow(0 0 18px #ffe6a15c); }
  .celestial .moon { opacity: 0; transform: rotate(-35deg) scale(.65); filter: drop-shadow(0 0 14px #ebf2cf66); }
  .celestial:hover .sun { filter: drop-shadow(0 0 22px #ffe6a180); }
  .celestial:focus-visible { outline: 1px dashed currentColor; outline-offset: 3px; }
  :global(body[data-time="night"]) { color: #f6efd9; background: #101e38; }
  :global(body[data-time="night"]) .landscape img { filter: brightness(.25) sepia(.6) hue-rotate(165deg) saturate(1.3); }
  :global(body[data-time="night"]) .scene-wash { opacity: 0; }
  :global(body[data-time="night"]) .night-wash, :global(body[data-time="night"]) .stars { opacity: 1; }
  :global(body[data-time="night"]) .celestial .sun { opacity: 0; transform: rotate(35deg) scale(.65); }
  :global(body[data-time="night"]) .celestial .moon { opacity: 1; transform: rotate(0) scale(1); }
  :global(body[data-time="night"]) h1 { text-shadow: 0 1px 18px rgba(6,18,40,.7); }
  :global(body[data-time="night"]) .headline-trigger:hover { color: #ffe4a6; }
  :global(.runner) { transition: filter .9s ease; }
  :global(body[data-time="night"] .runner) { filter: invert(1); }
  h1 { transition: color .9s ease, text-shadow .9s ease; }
  main { position: fixed; inset: 0; z-index: 1; pointer-events: none; width: min(1120px, calc(100% - 48px)); height: 100svh; margin-inline: auto; display: flex; flex-direction: column; padding-bottom: clamp(30px, 7vh, 80px); }
  .headline-trigger, :global(.runner) { pointer-events: auto; }
  .headline-trigger { display: inline-block; padding: 0; border: 0; background: transparent; color: inherit; font: inherit; cursor: pointer; text-shadow: inherit; transition: color .2s, transform .2s; }
  .headline-trigger:hover { color: #254f43; transform: translateY(-1px); }
  .headline-trigger:active { transform: translateY(1px); }
  .headline-trigger:focus-visible { outline: none; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 8px; }
  .headline { flex: 1; min-height: 50svh; display: grid; place-items: center; padding-block: 70px; text-align: center; }
  h1 { margin: 0; font-family: "Birthstone", cursive; font-size: clamp(22px, 5.6vw, 78px); font-weight: 400; line-height: 1.4; letter-spacing: 0; white-space: nowrap; text-shadow: 0 1px 14px rgba(255,255,255,.6); }
  @media (max-width: 480px) { main { width: calc(100% - 32px); padding-bottom: 24px; } }
  @media (prefers-reduced-motion: reduce) { .landscape img, .scene-wash, .night-wash, .stars, .celestial svg, h1, :global(.runner) { transition: none; } .headline-trigger { transition: none; transform: none; } }
</style>
