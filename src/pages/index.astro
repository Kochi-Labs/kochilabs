---
import DinoGame from '../components/DinoGame.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#dceef8" />
    <meta name="description" content="God’s own country is cooking something. Kochi Labs." />
    <title>God’s own country is cooking something. — Kochi Labs</title>
    <link rel="icon" href="data:," />
    <link rel="preload" href="/fonts/Birthstone-Regular.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body>
    <div class="landscape" aria-hidden="true">
      <img src="/images/kerala-backwaters-clean.png" alt="" fetchpriority="high" decoding="async" />
    </div>
    <canvas class="kerala-scene" tabindex="0" role="img" aria-label="Interactive Kerala backwaters. Click the water to make waves and float a lotus. Drag the houseboat, tap the metro, or scroll to explore. Press Enter to ripple the water."></canvas>
    <div class="scene-wash" aria-hidden="true"></div>
    <main>
      <div class="headline"><h1><button class="headline-trigger" type="button" aria-label="God’s own country is cooking something. Release birds and rock the houseboat.">God’s own country is cooking something.</button></h1></div>
      <DinoGame />
    </main>
  </body>
</html>

<script>
  import { createKeralaScene } from '../lib/kerala-scene';

  const canvas = document.querySelector<HTMLCanvasElement>('.kerala-scene')!;
  const headline = document.querySelector<HTMLButtonElement>('.headline-trigger')!;
  const scene = createKeralaScene(canvas, {
    backgroundUrl: '/images/kerala-backwaters-clean.png',
    onReady(supported) {
      document.body.dataset.scene = supported ? 'ready' : 'fallback';
    },
  });
  const scrollScene = () => {
    const travel = document.documentElement.scrollHeight - innerHeight;
    scene.setScroll(travel > 0 ? Math.min(1, Math.max(0, scrollY / travel)) : 0);
  };
  const stirScene = () => { scene.nudgeBoat(); scene.releaseBirds(); };
  const keyboardSplash = (event: KeyboardEvent) => {
    if (event.key !== 'Enter') return;
    event.preventDefault();
    scene.splashAt(innerWidth * .52, innerHeight * .73);
  };
  headline.addEventListener('click', stirScene);
  canvas.addEventListener('keydown', keyboardSplash);
  addEventListener('scroll', scrollScene, { passive: true });
  addEventListener('resize', scrollScene, { passive: true });
  scrollScene();
  addEventListener('pagehide', (event) => { if (!event.persisted) scene.destroy(); });
</script>

<style is:global>
  @font-face { font-family: "Birthstone"; src: url("/fonts/Birthstone-Regular.ttf") format("truetype"); font-weight: 400; font-style: normal; font-display: swap; }
  :root { font-family: Arial, Helvetica, sans-serif; color: #000; background: #dceef8; color-scheme: light; font-synthesis: none; -webkit-font-smoothing: antialiased; }
  * { box-sizing: border-box; }
  body { margin: 0; isolation: isolate; min-height: 175svh; overscroll-behavior-y: none; }
  button { font: inherit; -webkit-tap-highlight-color: transparent; }
  ::selection { color: #dceef8; background: #000; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
</style>

<style>
  .landscape { position: fixed; inset: 0; z-index: -2; pointer-events: none; overflow: hidden; }
  .landscape img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  .kerala-scene { position: fixed; inset: 0; z-index: -1; display: block; width: 100%; height: 100%; cursor: crosshair; outline: none; touch-action: pan-y; }
  .kerala-scene:focus-visible { box-shadow: inset 0 0 0 2px rgba(33,77,66,.35); }
  :global(body[data-scene="fallback"]) .kerala-scene { visibility: hidden; }
  .scene-wash { position: fixed; inset: 0; z-index: 0; pointer-events: none; background: linear-gradient(180deg, rgba(239,248,251,.10) 0%, rgba(239,248,251,.04) 48%, rgba(235,245,241,.02) 72%, rgba(235,245,241,.80) 89%, rgba(235,245,241,.94) 100%); }
  main { position: fixed; inset: 0; z-index: 1; pointer-events: none; width: min(1120px, calc(100% - 48px)); height: 100svh; margin-inline: auto; display: flex; flex-direction: column; padding-bottom: clamp(30px, 7vh, 80px); }
  .headline-trigger, :global(.runner) { pointer-events: auto; }
  .headline-trigger { display: inline-block; padding: 0; border: 0; background: transparent; color: inherit; font: inherit; cursor: pointer; text-shadow: inherit; transition: color .2s, transform .2s; }
  .headline-trigger:hover { color: #254f43; transform: translateY(-1px); }
  .headline-trigger:active { transform: translateY(1px); }
  .headline-trigger:focus-visible { outline: none; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 8px; }
  .headline { flex: 1; min-height: 50svh; display: grid; place-items: center; padding-block: 70px; text-align: center; }
  h1 { margin: 0; font-family: "Birthstone", cursive; font-size: clamp(22px, 5.6vw, 78px); font-weight: 400; line-height: 1.4; letter-spacing: 0; white-space: nowrap; text-shadow: 0 1px 14px rgba(255,255,255,.6); }
  @media (max-width: 480px) { main { width: calc(100% - 32px); padding-bottom: 24px; } }
  @media (prefers-reduced-motion: reduce) { .headline-trigger { transition: none; transform: none; } }
</style>
